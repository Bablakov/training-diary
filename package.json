{
  "name": "training-diary",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "description": "Дневник тренировок: программы, план наперёд, запись в зале, статистика. PWA для iPhone и приложение для Android, работает без сети, синхронизация через GitHub",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:android": "vite build --mode android",
    "preview": "vite preview --host",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "apk": "npm run build:android && cd android && gradlew.bat :app:assembleRelease",
    "build:desktop": "vite build --mode desktop",
    "exe": "npm run build:desktop && cd desktop && npm run dist:win"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "^5.2.6",
    "@fontsource-variable/golos-text": "^5.2.6",
    "@fontsource-variable/inter": "^5.2.6",
    "@fontsource-variable/manrope": "^5.2.6",
    "@fontsource-variable/onest": "^5.2.6",
    "@fontsource-variable/oswald": "^5.2.6",
    "@fontsource-variable/unbounded": "^5.2.6"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.11"
  }
}
